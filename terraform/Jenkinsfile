pipeline {
    agent any

    stages {

        stage('Terraform Init') {
            steps {
                dir('terraform/environments/dev') {
                    bat 'terraform init'
                }
            }
        }

        stage('Terraform Format') {
            steps {
                bat 'terraform fmt -check -recursive terraform'
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform/environments/dev') {
                    bat 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform/environments/dev') {
                    bat 'terraform plan'
                }
            }
        }
    }
}
