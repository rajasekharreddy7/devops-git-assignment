pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Build & Test') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn clean package'
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'ecommerce-app/target/*.jar',
                             fingerprint: true
        }
    }
}
