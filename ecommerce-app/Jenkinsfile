pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Build') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

	stage('Docker Build') {
 	   steps {
        	dir('ecommerce-app') {
           	 bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t ecommerce-app:1.0 .'
        	}
   	    }
	}

	stage('Docker Run') {
 	   steps {
        	bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" run --name ecommerce-app-ci ecommerce-app:1.0'
    		}
	   post {
        	always {
            	bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" rm ecommerce-app-ci'
        	}
    	   }
	}

        stage('Approval') {
            steps {
                input message: 'Approve to continue?', ok: 'Approve'
            }
        }
	}

    post {
        success {
            archiveArtifacts artifacts: 'ecommerce-app/target/*.jar',
                             fingerprint: true
        }
    }
}
