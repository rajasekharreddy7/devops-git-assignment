pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {

        stage('AWS Identity Test') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'jenkins-ecr'
                ]]) {
                    bat 'aws sts get-caller-identity'
                }
            }
        }

        stage('Build') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('ecommerce-app') {
                    bat 'mvn package -DskipTests'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('ecommerce-app') {
                    bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t ecommerce-app:%BUILD_NUMBER% .'
                }
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'jenkins-ecr'
                ]]) {
                    bat 'aws ecr get-login-password --region ap-south-2 | "C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" login --username AWS --password-stdin 006419716500.dkr.ecr.ap-south-2.amazonaws.com'
                }
            }
        }

        stage('ECR Tag') {
            steps {
                bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" tag ecommerce-app:%BUILD_NUMBER% 006419716500.dkr.ecr.ap-south-2.amazonaws.com/ecommerce-app:%BUILD_NUMBER%'
            }
        }

        stage('Approval') {
            steps {
                input message: 'Approve to continue?', ok: 'Approve'
            }
        }

        stage('ECR Push') {
            steps {
                bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" push 006419716500.dkr.ecr.ap-south-2.amazonaws.com/ecommerce-app:%BUILD_NUMBER%'
            }
        }

	stage('Kubernetes Deploy') {
    	    steps {
        	withEnv(['KUBECONFIG=C:\\Users\\lavan\\.kube\\config']) {
            	bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe" set image deployment/ecommerce-app ecommerce-app=006419716500.dkr.ecr.ap-south-2.amazonaws.com/ecommerce-app:%BUILD_NUMBER% -n ecommerce-dev'
            	bat '"C:\\Users\\lavan\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe" rollout status deployment/ecommerce-app -n ecommerce-dev'
        	}
    	   }
	}
	}

    post {
        success {
            archiveArtifacts artifacts: 'ecommerce-app/target/*.jar',
                             fingerprint: true
        }
    }
}
